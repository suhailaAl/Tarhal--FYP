                            <div class="w-checkbox-input w-checkbox-input--inputType-custom checkbox"></div><input type="checkbox" name="accommodation-availability-2" id="accommodation-availability-2" data-name="Accommodation Availability 2" if-id="e7ea08ff-ba85-6848-95e2-a946e3b0ecf9" style="opacity:0;position:absolute;z-index:-1"><span class="white-form-text checkbox-label w-form-label" for="accommodation-availability-2">Activity is available</span>
                        </label>
                    </div><input type="submit" data-wait="Please wait..." class="button white-form-button w-button" id="white-form-button" value="Submit">
                </div>
                <button type="button" class="button step-form-button back-button back-button-2 w-button" id="back-button-2">Back</button>
            </form>
            <script>
                                document.addEventListener('DOMContentLoaded', () => {
                    const forms = document.querySelectorAll('form');
                    forms.forEach(form => {
                        form.setAttribute('data-wf-no-form', true);
                    });
                });
                    document.addEventListener('DOMContentLoaded', () => {
                    const steps = Array.from(document.querySelectorAll('.white-form-step')); // All steps
                    let currentStep = 0; // Track the current step

                    const nextBtn = document.getElementById('white-form-button');
                    const backBtn = document.getElementById('back-button-2');
                    const form = document.getElementById('wf-form-New-Service-Form');

                                    // Function to show a specific step
                    const showStep = (index) => {
                        steps.forEach((step, i) => {
                            step.classList.toggle('hidden', i !== index); // Hide all except the current step
                        });

                        // Update button visibility and text
                        backBtn.classList.toggle('hidden', index === 0); // Hide "Back" on the first step
                        if (index === steps.length - 1) {
                            nextBtn.textContent = 'Submit'; // Change "Next" to "Submit" on the last step
                            nextBtn.type = 'submit'; // Change the button type to submit
                        } else {
                            nextBtn.textContent = 'Next'; // Reset "Submit" to "Next"
                            nextBtn.type = 'button'; // Reset the button type to button
                        }
                    };

                    // Show the initial step
                    showStep(currentStep);

                    // Next Button Click Handler
                    nextBtn.addEventListener('click', () => {
                        const currentDiv = steps[currentStep];

                        // For Step 1, ensure an option is selected
                        if (currentStep === 0) {
                            const selectedDiv = currentDiv.querySelector('.w--redirected-checked');
                            if (!selectedDiv) {
                                alert('Please select an option before proceeding!');
                                return;
                            }

                            // Optionally, get the associated Step 2 ID
                            const stepToShow = selectedDiv.getAttribute('data-step');
                            currentStep = steps.findIndex((step) => step.id === stepToShow);
                            showStep(currentStep);
                            return;
                        }

                        // If not the last step, move to the next step
                        if (currentStep < steps.length - 1) {
                            currentStep++;
                            showStep(currentStep);
                        }
                    });

                    // Back Button Click Handler
                    backBtn.addEventListener('click', () => {
                        if (currentStep > 0) {
                            currentStep = 0;
                            showStep(currentStep);
                        }
                    });

                    // Form Submit Handler
                    form.addEventListener('submit', (event) => {
                        event.preventDefault();
                        alert('Form submitted!');
                        console.log('Form submitted!');
                    });

                    // Handle click on custom radio button divs
                    const radioDivs = document.querySelectorAll('.w-form-formradioinput');
                    radioDivs.forEach((radioDiv) => {
                        radioDiv.addEventListener('click', (event) => {
                            const radioInput = radioDiv.querySelector('input[type="radio"]');

                            // Ensure the clicked div is for a valid radio input
                            if (radioInput) {
                                // Set the radio input to checked
                                radioInput.checked = true;

                                // Add the 'w--redirected-checked' class to the clicked div
                                radioDiv.classList.add('w--redirected-checked');

                                // Remove 'w--redirected-checked' from other divs
                                radioDivs.forEach((div) => {
                                    if (div !== radioDiv) {
                                        div.classList.remove('w--redirected-checked');
                                    }
                                });

                                // Optionally: you can fetch the associated step here if needed for step navigation
                                const stepToShow = radioDiv.getAttribute('data-step');
                                if (stepToShow) {
                                    const nextStep = document.getElementById(stepToShow);
                                    if (nextStep) {
                                        nextStep.classList.remove('hidden');
                                    }
                                }
                            }
                        });
                    });
                });

            </script>
            <div class="w-form-done">
                <div>Thank you! Your submission has been received!</div>
            </div>
            <div class="w-form-fail">
                <div>Oops! Something went wrong while submitting the form.</div>
            </div>
        </div>
    </div>
</div>
