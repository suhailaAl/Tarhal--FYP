@{
}
@Html.Partial("~/Views/Shared/_Navbar.cshtml")
<div class="white-form-section">
    <div class="container white-form-container no-steps">
        <div class="image-bg"></div>
        <h2 class="form-heading">join us <span class="text-span-2">and </span>offer <br>your service</h2>
        <div class="white-form w-form">
            <form id="email-form" name="email-form" data-name="Email Form" method="post" action="/Home/ServiceProviderRegister">
                <div class="input-wrapper"><label for="name" class="white-form-text">Company official name</label><input class="form-field white-form-field w-input" maxlength="256" name="name" data-name="Name" placeholder="" type="text" id="name"></div>
                <div class="input-wrapper"><label for="name-2" class="white-form-text">commercial register paper</label><input class="form-field white-form-field w-input" maxlength="256" name="name-2" data-name="Name 2" placeholder="" type="text" id="name-2"></div>
                <div class="input-wrapper"><label for="name-3" class="white-form-text">trade number</label><input class="form-field white-form-field w-input" maxlength="256" name="name-2" data-name="Name 2" placeholder="" type="text" id="name-2"></div>
                <div class="input-wrapper"><label for="name-3" class="white-form-text">tax number if any</label><input class="form-field white-form-field w-input" maxlength="256" name="name-2" data-name="Name 2" placeholder="" type="text" id="name-2"></div>
                <div class="input-wrapper"><label for="name-3" class="white-form-text">location</label><input class="form-field white-form-field w-input" maxlength="256" name="name-2" data-name="Name 2" placeholder="" type="text" id="name-2"></div>
                <div class="input-wrapper"><label for="name-3" class="white-form-text">email address</label><input class="form-field white-form-field w-input" maxlength="256" name="name-2" data-name="Name 2" placeholder="" type="text" id="name-2"></div>
                <div class="input-wrapper"><label for="name-3" class="white-form-text">phone number</label><input class="form-field white-form-field w-input" maxlength="256" name="name-2" data-name="Name 2" placeholder="" type="text" id="name-2"></div>
                <div class="input-wrapper"><label for="name-3" class="white-form-text">password</label><input class="form-field white-form-field w-input" maxlength="256" name="name-2" data-name="Name 2" placeholder="" type="text" id="name-2"></div>
                <div class="input-wrapper"><label for="name-3" class="white-form-text">type of service</label><input class="form-field white-form-field w-input" maxlength="256" name="name-2" data-name="Name 2" placeholder="" type="text" id="name-2"></div>
                <div class="input-wrapper"><label for="name-3" class="white-form-text">bank account number</label><input class="form-field white-form-field w-input" maxlength="256" name="name-2" data-name="Name 2" placeholder="" type="text" id="name-2"></div><input type="submit" data-wait="Please wait..." class="button white-form-button no-steps w-button" value="Submit">
            </form>
            <div class="w-form-done">
                <div>Thank you! Your submission has been received!</div>
            </div>
            <div class="w-form-fail">
                <div>Oops! Something went wrong while submitting the form.</div>
            </div>
        </div>
    </div>
</div>
<script src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=671dd0c9844df0983b62ad24" type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script>
