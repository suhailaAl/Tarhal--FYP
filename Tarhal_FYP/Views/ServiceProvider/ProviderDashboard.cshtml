@{
}
@Html.Partial("~/Views/Shared/_Navbar.cshtml")
<div class="container provider-dashboard">
    <h3>Wecome <span>@ViewBag.Provider.Name</span></h3>
    <div class="services-container">
        @foreach (var s in ViewBag.services)
        {
            <div class="provider-service">
                <div class="padding-div">
                    <div class="service-rate">
                        @for (int j = 0; j < 5; j++)
                        {
                            <i class="fa-solid fa-star"></i>
                        }
                    </div>
                    <h5 class="service-name">@s.Name</h5>
                    <p class="service-detail">@s.Address</p>
                </div>
                <div class="service-img">
                    <img src="~/images/katerina-kerdi-NybQgLnzrS4-unsplash-p-1080.jpg" />
                </div>
                <div class="service-modification">
                    <a href="@Url.Action("Update_Service", "ServiceProvider", new { id = s.ServiceId })"><img src="~/images/icons8-edit-24.png" alt="Alternate Text" /></a>
                    <a href="#"><img src="~/images/icons8-delete-24.png" alt="Alternate Text" /></a>
                </div>
            </div>
        }
    </div>
</div>
