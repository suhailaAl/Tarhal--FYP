@{
    ViewData["Title"] = "Home Page";
}
 <div class="img-div">
    @Html.Partial("~/Views/Shared/_Navbar.cshtml")
    <div class="hero-section">
      <div class="w-layout-blockcontainer container hero-container w-container">
        <h1 class="hero-header">Explore <span class="oman-text-hero">Oman </span>&#x27;<span class="text-span">s</span> Wonder </h1>
        <p class="hero-pragraph">Start your journey, book unique adventures, and immerse yourself in its rich culture, history, and nature ...</p>
        <div class="hero-buttons">
                <a asp-area="" asp-controller="Home" asp-action="Plan_Form" class="button hero-button w-button">Plan Your Trip</a>
                <a asp-area="" asp-controller="Home" asp-action="Nearby" class="button hero-button hero-button-secondary w-button">Find Nearby Destinations</a>
        </div>
      </div>
    </div>
  </div>
  <div class="cta-section">
    <div class="container cat-container">
      <h2 class="cta-header">plan your perfect Oman adventure</h2>
      <div id="w-node-_62d3a2cf-ba2f-119f-5c54-21a69d3d1fc8-3b62ad2c" class="cat-col-2">
        <p id="w-node-_07264943-aeb2-6885-1dab-0ae6ca3a0104-3b62ad2c" class="cta-paragraph">Discover the beauty and culture of Oman by starting to plan your trip today. Whether you&#x27;re looking for breathtaking landscapes or rich history, we have everything you need to create unforgettable memories.</p>
        <a href="#" class="button cat-button w-button">How about organizing an exhilarating journey? ✨</a>
      </div>
    </div>
  </div>
  <div class="cta-section cta-2-section">
    <div class="container cat-2-container">
      <h2 class="cta-header cat-2-header">Discover Exciting Nearby Destinations for Your Next Adventure in Oman</h2>
      <p class="cta-paragraph">Discover stunning nearby destinations and one-of-a-kind experiences waiting for you in Oman.</p>
      <div class="multi-step-form w-form">
            <a asp-area="" asp-controller="Home" asp-action="Nearby" class="button form-button w-button">Find Nearby Destinations</a>
        <div class="w-form-done">
          <div></div>
        </div>
        <div class="w-form-fail">
          <div>Oops! It seems like you coordinates are wrong.</div>
        </div>
      </div>
    </div>
  </div>
