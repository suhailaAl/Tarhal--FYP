@{
    TarhalDbContext db = new TarhalDbContext();
}
@Html.Partial("~/Views/Shared/_Navbar.cshtml")
<div class="plan-section">
    <div class="container plan-container">
        <div id="w-node-_1ac40fc5-7423-324e-b16f-ad6d894affb4-cca46ca2" class="plan-details">
            <div class="plan-period-destination">
                <h2 class="plan-period-destination-heading">@($"{ViewBag.dur} days trip in {ViewBag.des}")</h2>
            </div>
            <div class="plan-name">
                <h1 class="plan-name-heading">@ViewBag.name</h1>
            </div>
        </div>
        <div id="w-node-_120827f0-c289-9313-c82a-77eddd22bf7e-cca46ca2" class="day-by-day-plan">
            @for (int d = 0; d < ViewBag.plan.Count; d++)
            {
                <div class="day-plan">
                    <h3 class="day-header"><span class="day-number">@($"Day {d + 1}:")</span> | @(ViewBag.StartDate.AddDays(d))</h3>
                    <div class="stops-wrapper">
                        @foreach(ServiceClusterData p in ViewBag.plan[d]){
                            var image = (from g in db.Images
                                         where g.ServiceId == p.Id
                                         select g.ImageData).FirstOrDefault();
                            
                            <div class="stop">
                                @* <img class="top-img" src="https://d3e54v103j8qbb.cloudfront.net/plugins/Basic/assets/placeholder.60f9b1840c.svg" /> *@
                                @{
                                    if (image != null)
                                    {
                                        string base64Image = Convert.ToBase64String(image);
                                        <img src="data:image/jpeg;base64,@base64Image" loading="lazy" alt="@p.Name" class="top-img">
                                    }
                                    else
                                    {
                                        <img src="https://d3e54v103j8qbb.cloudfront.net/plugins/Basic/assets/placeholder.60f9b1840c.svg" loading="lazy" alt="@p.Name" class="top-img">
                                    }
                                }
                                <h4 class="stop-name">@p.Name</h4>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
        <div id="w-node-_1ab3cd54-6f3a-1139-ea2f-10f45859e83e-cca46ca2" class="plan-map">
            <div class="map-container" id="mapDiv"></div>
        </div>
    </div>
</div>
<script type="text/javascript">
            async function initMap() {
        // Request needed libraries
        const { Map } = await google.maps.importLibrary("maps");
        const { AdvancedMarkerElement } = await google.maps.importLibrary("marker");

        const center = { lat: 17.0207, lng: 54.0937 };
        const map = new Map(document.getElementById("mapDiv"), {
            zoom: 11,
            center,
            mapId: "Plan_Map",
        });


        // Parse planRoutes from ViewBag
        var planRoutes = @Html.Raw(Json.Serialize(ViewBag.planRoutes));
        console.log(planRoutes);
        // Prepare properties from the first route
        var properties = [];
        planRoutes[0].forEach(function (location) {
            properties.push({
                name: location.name,
                address: location.address,
                position: {
                    lat: location.lat,
                    lng: location.lng,
                },
                type: location.category,
                price: location.price,
            });
        });

        console.log(properties);

        // Add markers to the map
        for (const property of properties) {
            const marker = new AdvancedMarkerElement({
                map,
                content: buildContent(property),
                position: property.position,
                title: property.name,
            });

            marker.addListener("click", () => {
                toggleHighlight(marker, property);
            });
        }

        // Initialize Directions Service and Renderer
        const directionsService = new google.maps.DirectionsService();
        const directionsRenderer = new google.maps.DirectionsRenderer({ map: map });

        // Display route
        const day = 0; // Example day index, replace it dynamically if needed
        calculateAndDisplayRoute(planRoutes, day, directionsService, directionsRenderer);
    }

    // Toggle marker highlight
    function toggleHighlight(markerView, property) {
        if (markerView.content.classList.contains("highlight")) {
            markerView.content.classList.remove("highlight");
            markerView.zIndex = null;
        } else {
            markerView.content.classList.add("highlight");
            markerView.zIndex = 1;
        }
    }

    // Build marker content
    function buildContent(property) {
        const content = document.createElement("div");

        content.classList.add("property");
        content.innerHTML = `
            <div class="icon">
                <i aria-hidden="true" class="fa fa-icon fa-${property.type}" title="${property.type}"></i>
                <span class="fa-sr-only">${property.type}</span>
            </div>
            <div class="details">
                <div class="name">${property.name}</div>
                <div class="address">${property.address}</div>
                <div class="features">
                    <div>
                        <i aria-hidden="true" class="fa fa-dollar-sign fa-lg price" title="price"></i>
                        <span>${property.price}</span>
                    </div>
                </div>
            </div>
        `;
        return content;
    }

    // Calculate and display route
    function calculateAndDisplayRoute(planRoutes, day, directionsService, directionsRenderer) {
        // Prepare waypoints
        const waypts = [];
        planRoutes[day].forEach(function (location) {
            waypts.push({
                location: new google.maps.LatLng(location.lat, location.lng),
                stopover: true
            });
        });
        waypts.shift();

        // Create directions request
        directionsService.route(
            {
                origin: new google.maps.LatLng(planRoutes[day][0].lat, planRoutes[day][0].lng),
                destination: new google.maps.LatLng(planRoutes[day][0].lat, planRoutes[day][0].lng),
                waypoints: waypts,
                optimizeWaypoints: true,
                travelMode: google.maps.TravelMode.DRIVING
            },
            (response, status) => {
                if (status === 'OK') {
                    directionsRenderer.setDirections(response);
                } else {
                    window.alert('Directions request failed due to ' + status);
                }
            }
        );
    }

    initMap();
</script>
<script src="https://use.fontawesome.com/releases/v6.2.0/js/all.js"></script>
